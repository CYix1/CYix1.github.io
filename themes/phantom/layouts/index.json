{{- $pages := slice -}}
{{- range site.RegularPages -}}
  {{- if ne .Params.layout "search" -}}
    {{- $pages = $pages | append (dict "title" .Title "url" .RelPermalink "section" .Section "tags" (.Params.tags | default slice) "summary" (.Summary | plainify | truncate 200) "content" .Plain) -}}
  {{- end -}}
{{- end -}}
{{- $pages | jsonify -}}
